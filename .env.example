APP_NAME=RadioRing
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# UI language: en | de
# The English strings are the translation keys, lang/de.json supplies German.
APP_LOCALE=de
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

# all = web, queue and scheduler in one container (only relevant in the Docker image).
# Use web | queue | scheduler instead to split them across containers.
APP_MODE=all

# Operating mode: standalone | cloud
#   standalone = one installation, one tenant, one shared media library. Invited
#                users join that tenant. No station quota, no impersonation, no
#                account bans.
#   cloud      = many independent tenants. Every registration opens a tenant of
#                its own, with its own library.
RADIORING_MODE=standalone

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=radioring
DB_USERNAME=radioring
DB_PASSWORD=secret
DB_ROOT_PASSWORD=rootsecret

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ─────────────────────────────────────────────────────────────────────────────
# RadioRing: Liquidsoap station containers
# ─────────────────────────────────────────────────────────────────────────────

# Base URL under which the Liquidsoap container reaches the app (pull API).
# It has to be reachable from inside that container. Empty = APP_URL.
# Locally with Docker Desktop: http://host.docker.internal:8000
LIQUIDSOAP_API_URL=

# Docker image of the station container (built to GHCR by
# .github/workflows/liquidsoap-station.yml – adjust the owner to your repository).
STATION_IMAGE=ghcr.io/radioring/liquidsoap-station:latest

# Label RadioRing marks its own containers with.
STATION_MANAGED_BY=radioring

# Only needed when STATION_IMAGE lives in a private registry
# (GHCR: GitHub username plus a PAT with read:packages).
STATION_REGISTRY_USERNAME=
STATION_REGISTRY_PASSWORD=

# ─────────────────────────────────────────────────────────────────────────────
# RadioRing: container control (starts and stops the station containers)
# ─────────────────────────────────────────────────────────────────────────────
# WARNING: anyone who reaches the Docker API can start a privileged container
# with the host root mounted, and is root on the host from there. The socket
# proxy reduces the attack surface, it is NOT a security boundary.
# See SECURITY.md.
#
# docker    = straight against the Docker Engine API (default)
# portainer = legacy driver going through the Portainer API
CONTAINER_DRIVER=docker

# tcp://dockerproxy:2375       socket proxy (recommended, the compose default)
# unix:///var/run/docker.sock  socket mounted into the app container directly
DOCKER_HOST=unix:///var/run/docker.sock
DOCKER_API_VERSION=v1.43

# Named Docker network that new station containers join. With one set,
# LIQUIDSOAP_API_URL=http://app:8080 is enough and the traffic no longer has to
# go out over the public address. Empty = default bridge (previous behaviour).
DOCKER_STATION_NETWORK=

# The station image is several hundred megabytes, so 30 seconds are not enough
# for a cold start.
DOCKER_PULL_TIMEOUT=600

# Lifetime of the signed delivery URLs (media and prepared content). Generous on
# purpose: the pull cursor runs ahead of what is on air, and a hard start can
# hold items back. A signature that expires first means silence on air.
DELIVERY_URL_TTL_SECONDS=21600

# Legacy: only with CONTAINER_DRIVER=portainer
#PORTAINER_ENDPOINT=https://portainer.example.com/api
#PORTAINER_TOKEN=
#PORTAINER_ENVIRONMENT=2

# ─────────────────────────────────────────────────────────────────────────────
# RadioRing: Redis command relay (skip / hard cut / stop from the dashboard)
# ─────────────────────────────────────────────────────────────────────────────
# The app and the station containers have to use the same Redis instance and the
# same channel. Note that Redis pub/sub is instance-wide; REDIS_DB only affects
# keys.
LIQUIDSOAP_CONTROL_CHANNEL=radioring_station_control
REDIS_DB=0
# A different Redis address for the station containers (empty = REDIS_HOST).
STATION_REDIS_HOST=

# ─────────────────────────────────────────────────────────────────────────────
# RadioRing: live input (one input.harbor per station)
# ─────────────────────────────────────────────────────────────────────────────
# Encoders connect to {slug}.STREAM_DOMAIN:{port}. Empty = nothing is published
# (local development). The host ports in that range have to be open in the
# firewall, and DNS *.STREAM_DOMAIN has to point at the server.
STREAM_DOMAIN=
STREAM_PORT_MIN=8001
STREAM_PORT_MAX=8099
STREAM_MOUNT=/live
STREAM_USERNAME=source

# ─────────────────────────────────────────────────────────────────────────────
# RadioRing: loudness (measured offline on upload via ffmpeg)
# ─────────────────────────────────────────────────────────────────────────────
LOUDNESS_NORMALIZATION=true
# Empty = the target value from config/radioring.php
LOUDNESS_TARGET_LUFS=
LOUDNESS_MAX_TRUE_PEAK_DBTP=-1.0
FFMPEG_PATH=ffmpeg

# ─────────────────────────────────────────────────────────────────────────────
# RadioRing: Stereo Tool (optional, proprietary – see
# docker/liquidsoap-station/stereotool/README.md)
# ─────────────────────────────────────────────────────────────────────────────
STEREO_TOOL_LIBRARY_FILE=/opt/stereotool/libStereoTool.so
STEREO_TOOL_PRESETS_PATH=/opt/stereotool/presets

# ─────────────────────────────────────────────────────────────────────────────
# RadioRing: news and ad break (optional)
# ─────────────────────────────────────────────────────────────────────────────
# Empty = the news slot is skipped.
NEWS_SIGNAL_PATH=
NEWS_DURATION_SECONDS=300
# Signal MP3 for the laut.fm ad break marker (shipped inside the station image).
ADBREAK_SIGNAL_PATH=/opt/ad_break.mp3

# ─────────────────────────────────────────────────────────────────────────────
# RadioRing: Syndications4Radio partner API (optional, external sources)
# ─────────────────────────────────────────────────────────────────────────────
S4R_API_BASE_URL=https://syndications4radio.de/api/v1/partner
